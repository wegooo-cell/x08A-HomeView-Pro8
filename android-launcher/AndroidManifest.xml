<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="io.github.wegooo_cell.homeview" android:versionCode="175" android:versionName="0.1.3">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="28" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="dev.pro8.bili.permission.WIDGET" />
    <uses-permission android:name="android.permission.VIBRATE" /><uses-permission android:name="android.permission.ACCESS_WIFI_STATE" /><uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" /><uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" /><uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <application android:name="dev.pro8.homeview.direct.HomeViewApplication" android:label="x08A HomeView Pro8" android:icon="@drawable/pro8_icon" android:theme="@style/HomeViewTheme" android:usesCleartextTraffic="true" android:allowBackup="false" android:hardwareAccelerated="true">
        <receiver android:name="dev.pro8.homeview.direct.HomeViewAdmin" android:permission="android.permission.BIND_DEVICE_ADMIN" android:exported="true">
            <meta-data android:name="android.app.device_admin" android:resource="@xml/homeview_admin" />
            <intent-filter><action android:name="android.app.action.DEVICE_ADMIN_ENABLED" /></intent-filter>
        </receiver>
        <service android:name="dev.pro8.homeview.direct.ClockRingingService" android:exported="false" />
        <receiver android:name="dev.pro8.homeview.direct.ClockAlarmReceiver" android:exported="false" />
        <receiver android:name="dev.pro8.homeview.direct.TimerAlarmReceiver" android:exported="false" />
        <receiver android:name="dev.pro8.homeview.direct.BootReceiver" android:exported="false">
            <intent-filter><action android:name="android.intent.action.BOOT_COMPLETED" /><action android:name="android.intent.action.TIME_SET" /><action android:name="android.intent.action.TIMEZONE_CHANGED" /></intent-filter>
        </receiver>
        <service android:name="dev.pro8.homeview.direct.AirPlayService" android:exported="false" />
        <service android:name="dev.pro8.homeview.direct.ReturnOverlayService" android:exported="false" />
        <provider android:name="dev.pro8.homeview.direct.LocalFileProvider" android:authorities="io.github.wegooo_cell.homeview.localfiles" android:exported="false" android:grantUriPermissions="true"><grant-uri-permission android:pathPrefix="/file/" /></provider>
        <provider android:name="dev.pro8.homeview.direct.WallpaperProvider" android:authorities="io.github.wegooo_cell.homeview.wallpaper" android:exported="false" android:grantUriPermissions="true" />
        <activity android:name="dev.pro8.homeview.direct.WallpaperPickerActivity" android:exported="true" android:screenOrientation="landscape">
            <meta-data android:name="com.xiaomi.mico.no-global-action" android:value="true" />
            <meta-data android:name="com.xiaomi.mico.disable-lockscreen-gesture" android:value="true" />
        </activity>
        <activity android:name="dev.pro8.homeview.direct.HomeAssistantActivity" android:exported="false" android:screenOrientation="landscape" />
        <activity android:name="dev.pro8.homeview.direct.SetupActivity" android:exported="true" android:permission="android.permission.DUMP" android:screenOrientation="landscape" />
        <activity android:name="dev.pro8.homeview.direct.HomeActivity" android:exported="true" android:launchMode="singleTask" android:screenOrientation="landscape">
            <!-- Pro8 SystemUI reads these activity flags on foreground changes.
                 HomeView owns its navigation; keep the OEM bottom/edge overlays
                 from intercepting the home indicator before WebView receives it. -->
            <meta-data android:name="com.xiaomi.mico.no-global-action" android:value="true" />
            <meta-data android:name="com.xiaomi.mico.disable-lockscreen-gesture" android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
